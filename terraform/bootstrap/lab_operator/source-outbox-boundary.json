{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Effect": "Allow",
      "Action": [
        "dynamodb:Query",
        "dynamodb:UpdateItem"
      ],
      "Resource": [
        "arn:aws:dynamodb:us-east-1:414053644145:table/cosmotech-orders-outbox",
        "arn:aws:dynamodb:us-east-1:414053644145:table/cosmotech-orders-outbox/index/dispatch-due"
      ],
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-east-1"
        }
      }
    },
    {
      "Effect": "Allow",
      "Action": [
        "sqs:SendMessage"
      ],
      "Resource": "arn:aws:sqs:us-east-1:414053644145:aws-eks-istio-lab-dev-orders-eks",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-east-1"
        }
      }
    },
    {
      "Effect": "Deny",
      "Action": [
        "iam:*",
        "account:*",
        "organizations:*"
      ],
      "Resource": "*"
    }
  ]
}
