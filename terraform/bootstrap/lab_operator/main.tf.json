{
  "terraform": {
    "required_version": "= 1.17.1",
    "required_providers": {
      "aws": {
        "source": "hashicorp/aws",
        "version": "= 6.62.0"
      }
    },
    "backend": {
      "local": {}
    }
  },
  "provider": {
    "aws": {
      "region": "us-east-1",
      "allowed_account_ids": [
        "414053644145"
      ],
      "default_tags": {
        "tags": {
          "Project": "CosmoTech",
          "Environment": "dev",
          "ManagedBy": "Terraform",
          "Purpose": "lab-recovery-operator"
        }
      }
    }
  },
  "resource": {
    "aws_iam_role": {
      "operator": {
        "name": "cosmotech-lab-operator",
        "max_session_duration": 3600,
        "assume_role_policy": "{\"Version\": \"2012-10-17\", \"Statement\": [{\"Effect\": \"Allow\", \"Principal\": {\"AWS\": \"arn:aws:iam::414053644145:user/serverless-lab-admin\"}, \"Action\": \"sts:AssumeRole\"}]}",
        "lifecycle": {
          "prevent_destroy": true
        }
      }
    },
    "aws_iam_role_policy": {
      "operator": {
        "name": "scoped-lab-recovery",
        "role": "${aws_iam_role.operator.id}",
        "policy": "${file(\"${path.module}/operator-policy.json\")}"
      }
    },
    "aws_eks_access_entry": {
      "operator": {
        "cluster_name": "aws-eks-istio-lab-dev",
        "principal_arn": "${aws_iam_role.operator.arn}",
        "type": "STANDARD"
      }
    },
    "aws_eks_access_policy_association": {
      "operator": {
        "cluster_name": "aws-eks-istio-lab-dev",
        "principal_arn": "${aws_iam_role.operator.arn}",
        "policy_arn": "arn:aws:eks::aws:cluster-access-policy/AmazonEKSClusterAdminPolicy",
        "access_scope": {
          "type": "cluster"
        },
        "depends_on": [
          "aws_eks_access_entry.operator"
        ]
      }
    }
  },
  "output": {
    "operator_role_arn": {
      "value": "${aws_iam_role.operator.arn}"
    }
  }
}
