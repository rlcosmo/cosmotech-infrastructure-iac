{
  "terraform": {
    "required_version": "= 1.17.1",
    "required_providers": {
      "aws": {
        "source": "hashicorp/aws",
        "version": "= 6.62.0"
      }
    },
    "backend": {
      "local": {}
    }
  },
  "provider": {
    "aws": {
      "region": "us-east-1",
      "allowed_account_ids": [
        "414053644145"
      ],
      "default_tags": {
        "tags": {
          "Project": "CosmoTech",
          "Environment": "dev",
          "ManagedBy": "Terraform",
          "Purpose": "lab-recovery-operator"
        }
      }
    }
  },
  "resource": {
    "aws_iam_role": {
      "operator": {
        "name": "cosmotech-lab-operator",
        "max_session_duration": 3600,
        "assume_role_policy": "{\"Version\": \"2012-10-17\", \"Statement\": [{\"Effect\": \"Allow\", \"Principal\": {\"AWS\": \"arn:aws:iam::414053644145:user/serverless-lab-admin\"}, \"Action\": \"sts:AssumeRole\"}]}",
        "lifecycle": {
          "prevent_destroy": true
        }
      },
      "dr_provisioner": {
        "name": "cosmotech-dr-provisioner",
        "max_session_duration": 3600,
        "assume_role_policy": "{\"Version\": \"2012-10-17\", \"Statement\": [{\"Effect\": \"Allow\", \"Principal\": {\"AWS\": \"arn:aws:iam::414053644145:role/cosmotech-lab-operator\"}, \"Action\": \"sts:AssumeRole\"}]}",
        "tags": {
          "Environment": "dr",
          "Purpose": "isolated-Ohio-provisioning"
        },
        "lifecycle": {
          "prevent_destroy": true
        }
      },
      "source_outbox_publisher": {
        "name": "cosmotech-source-outbox-publisher",
        "permissions_boundary": "${aws_iam_policy.source_outbox_boundary.arn}",
        "assume_role_policy": "{\"Version\": \"2012-10-17\", \"Statement\": [{\"Effect\": \"Allow\", \"Principal\": {\"Service\": \"pods.eks.amazonaws.com\"}, \"Action\": [\"sts:AssumeRole\", \"sts:TagSession\"], \"Condition\": {\"StringEquals\": {\"aws:SourceAccount\": \"414053644145\", \"aws:RequestTag/kubernetes-namespace\": \"orders-api\", \"aws:RequestTag/kubernetes-service-account\": \"orders-outbox-publisher\"}, \"ArnEquals\": {\"aws:SourceArn\": \"arn:aws:eks:us-east-1:414053644145:cluster/aws-eks-istio-lab-dev\"}}}]}",
        "max_session_duration": 3600,
        "tags": {
          "Environment": "dr-preparation"
        },
        "lifecycle": {
          "prevent_destroy": true
        }
      }
    },
    "aws_iam_role_policy": {
      "operator": {
        "name": "scoped-lab-recovery",
        "role": "${aws_iam_role.operator.id}",
        "policy": "${file(\"${path.module}/operator-policy.json\")}"
      }
    },
    "aws_eks_access_entry": {
      "operator": {
        "cluster_name": "aws-eks-istio-lab-dev",
        "principal_arn": "${aws_iam_role.operator.arn}",
        "type": "STANDARD"
      }
    },
    "aws_eks_access_policy_association": {
      "operator": {
        "cluster_name": "aws-eks-istio-lab-dev",
        "principal_arn": "${aws_iam_role.operator.arn}",
        "policy_arn": "arn:aws:eks::aws:cluster-access-policy/AmazonEKSClusterAdminPolicy",
        "access_scope": {
          "type": "cluster"
        },
        "depends_on": [
          "aws_eks_access_entry.operator"
        ]
      }
    },
    "aws_iam_policy": {
      "dr_runtime_boundary": {
        "name": "cosmotech-dr-runtime-boundary",
        "description": "Maximum destination-only application/service privileges; no IAM/account administration.",
        "policy": "${file(\"${path.module}/dr-runtime-boundary.json\")}",
        "tags": {
          "Environment": "dr",
          "Purpose": "regional-runtime-boundary"
        },
        "lifecycle": {
          "prevent_destroy": true
        }
      },
      "dr_provisioner_1": {
        "name": "cosmotech-dr-provisioner-1",
        "policy": "${file(\"${path.module}/dr-provisioner-1.json\")}",
        "tags": {
          "Environment": "dr"
        },
        "lifecycle": {
          "prevent_destroy": true
        }
      },
      "dr_provisioner_2": {
        "name": "cosmotech-dr-provisioner-2",
        "policy": "${file(\"${path.module}/dr-provisioner-2.json\")}",
        "tags": {
          "Environment": "dr"
        },
        "lifecycle": {
          "prevent_destroy": true
        }
      },
      "dr_provisioner_3": {
        "name": "cosmotech-dr-provisioner-3",
        "policy": "${file(\"${path.module}/dr-provisioner-3.json\")}",
        "tags": {
          "Environment": "dr"
        },
        "lifecycle": {
          "prevent_destroy": true
        }
      },
      "dr_provisioner_4": {
        "name": "cosmotech-dr-provisioner-4",
        "policy": "${file(\"${path.module}/dr-provisioner-4.json\")}",
        "tags": {
          "Environment": "dr"
        },
        "lifecycle": {
          "prevent_destroy": true
        }
      },
      "dr_provisioner_5": {
        "name": "cosmotech-dr-provisioner-5",
        "policy": "${file(\"${path.module}/dr-provisioner-5.json\")}",
        "tags": {
          "Environment": "dr"
        },
        "lifecycle": {
          "prevent_destroy": true
        }
      },
      "source_dr_operations": {
        "name": "cosmotech-lab-source-dr-operations",
        "policy": "${file(\"${path.module}/source-dr-operations.json\")}",
        "tags": {
          "Environment": "dr"
        },
        "lifecycle": {
          "prevent_destroy": true
        }
      },
      "source_outbox_producer": {
        "name": "cosmotech-orders-outbox-producer",
        "policy": "${file(\"${path.module}/source-outbox-producer.json\")}",
        "tags": {
          "Environment": "dr-preparation"
        },
        "lifecycle": {
          "prevent_destroy": true
        }
      },
      "source_outbox_publisher": {
        "name": "cosmotech-orders-outbox-publisher",
        "policy": "${file(\"${path.module}/source-outbox-publisher.json\")}",
        "tags": {
          "Environment": "dr-preparation"
        },
        "lifecycle": {
          "prevent_destroy": true
        }
      },
      "source_outbox_boundary": {
        "name": "cosmotech-source-outbox-runtime-boundary",
        "policy": "${file(\"${path.module}/source-outbox-boundary.json\")}",
        "tags": {
          "Environment": "dr-preparation"
        },
        "lifecycle": {
          "prevent_destroy": true
        }
      },
      "zabbix_working_copy": {
        "name": "cosmotech-lab-zabbix-working-copy",
        "policy": "${file(\"${path.module}/zabbix-working-copy.json\")}",
        "tags": {
          "Environment": "dr"
        },
        "lifecycle": {
          "prevent_destroy": true
        }
      },
      "dr_ingress_operations": {
        "name": "cosmotech-lab-dr-ingress-operations",
        "policy": "${file(\"${path.module}/dr-ingress-operations.json\")}",
        "tags": {
          "Environment": "dr"
        },
        "lifecycle": {
          "prevent_destroy": true
        }
      }
    },
    "aws_iam_role_policy_attachment": {
      "dr_provisioner_1": {
        "role": "${aws_iam_role.dr_provisioner.name}",
        "policy_arn": "${aws_iam_policy.dr_provisioner_1.arn}"
      },
      "dr_provisioner_2": {
        "role": "${aws_iam_role.dr_provisioner.name}",
        "policy_arn": "${aws_iam_policy.dr_provisioner_2.arn}"
      },
      "dr_provisioner_3": {
        "role": "${aws_iam_role.dr_provisioner.name}",
        "policy_arn": "${aws_iam_policy.dr_provisioner_3.arn}"
      },
      "dr_provisioner_4": {
        "role": "${aws_iam_role.dr_provisioner.name}",
        "policy_arn": "${aws_iam_policy.dr_provisioner_4.arn}"
      },
      "dr_provisioner_5": {
        "role": "${aws_iam_role.dr_provisioner.name}",
        "policy_arn": "${aws_iam_policy.dr_provisioner_5.arn}"
      },
      "source_dr_operations": {
        "role": "${aws_iam_role.operator.name}",
        "policy_arn": "${aws_iam_policy.source_dr_operations.arn}"
      },
      "source_outbox_producer": {
        "role": "aws-eks-istio-lab-dev-orders-api-role",
        "policy_arn": "${aws_iam_policy.source_outbox_producer.arn}"
      },
      "source_outbox_publisher": {
        "role": "${aws_iam_role.source_outbox_publisher.name}",
        "policy_arn": "${aws_iam_policy.source_outbox_publisher.arn}"
      },
      "operator_dr_recovery_ssm": {
        "role": "${aws_iam_role.operator.name}",
        "policy_arn": "${aws_iam_policy.dr_provisioner_5.arn}"
      },
      "zabbix_working_copy": {
        "role": "${aws_iam_role.operator.name}",
        "policy_arn": "${aws_iam_policy.zabbix_working_copy.arn}"
      },
      "operator_dr_scope_1": {
        "role": "${aws_iam_role.operator.name}",
        "policy_arn": "${aws_iam_policy.dr_provisioner_1.arn}"
      },
      "operator_dr_scope_2": {
        "role": "${aws_iam_role.operator.name}",
        "policy_arn": "${aws_iam_policy.dr_provisioner_2.arn}"
      },
      "operator_dr_scope_3": {
        "role": "${aws_iam_role.operator.name}",
        "policy_arn": "${aws_iam_policy.dr_provisioner_3.arn}"
      },
      "operator_dr_scope_4": {
        "role": "${aws_iam_role.operator.name}",
        "policy_arn": "${aws_iam_policy.dr_provisioner_4.arn}"
      },
      "dr_ingress_operations": {
        "role": "${aws_iam_role.operator.name}",
        "policy_arn": "${aws_iam_policy.dr_ingress_operations.arn}"
      }
    }
  },
  "output": {
    "operator_role_arn": {
      "value": "${aws_iam_role.operator.arn}"
    },
    "dr_runtime_boundary_arn": {
      "value": "${aws_iam_policy.dr_runtime_boundary.arn}"
    },
    "dr_provisioner_role_arn": {
      "value": "${aws_iam_role.dr_provisioner.arn}"
    }
  }
}
