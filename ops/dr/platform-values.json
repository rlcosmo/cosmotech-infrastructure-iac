{
  "istio-base": {},
  "istiod": {
    "pilot": {
      "replicaCount": 1
    }
  },
  "istio-ingress": {
    "replicaCount": 1,
    "service": {
      "type": "ClusterIP"
    },
    "labels": {
      "istio": "dr-ingress"
    }
  },
  "argocd": {
    "configs": {
      "params": {
        "server.insecure": "false"
      }
    },
    "server": {
      "service": {
        "type": "ClusterIP"
      }
    },
    "redis-ha": {
      "enabled": false
    }
  },
  "monitoring": {
    "grafana": {
      "admin": {
        "existingSecret": "dr-grafana-admin",
        "userKey": "admin-user",
        "passwordKey": "admin-password"
      },
      "persistence": {
        "enabled": true,
        "storageClassName": "gp3-retain",
        "size": "10Gi"
      },
      "sidecar": {
        "dashboards": {
          "enabled": true,
          "label": "grafana_dashboard",
          "searchNamespace": "observability"
        }
      },
      "additionalDataSources": [
        {
          "name": "Loki DR",
          "type": "loki",
          "url": "http://loki.observability.svc.cluster.local:3100",
          "access": "proxy"
        },
        {
          "name": "Tempo DR",
          "type": "tempo",
          "url": "http://tempo.observability.svc.cluster.local:3200",
          "access": "proxy"
        }
      ]
    },
    "prometheus": {
      "prometheusSpec": {
        "retention": "24h",
        "resources": {
          "requests": {
            "memory": "256Mi",
            "cpu": "100m"
          }
        },
        "storageSpec": {
          "volumeClaimTemplate": {
            "spec": {
              "storageClassName": "gp3-retain",
              "accessModes": [
                "ReadWriteOnce"
              ],
              "resources": {
                "requests": {
                  "storage": "10Gi"
                }
              }
            }
          }
        }
      }
    },
    "alertmanager": {
      "alertmanagerSpec": {
        "replicas": 1
      }
    }
  },
  "otel": {
    "mode": "deployment",
    "image": {
      "repository": "otel/opentelemetry-collector-k8s"
    },
    "config": {
      "exporters": {
        "debug": {},
        "otlp/tempo": {
          "endpoint": "tempo.observability.svc.cluster.local:4317",
          "tls": {
            "insecure": true
          }
        },
        "otlphttp/loki": {
          "endpoint": "http://loki.observability.svc.cluster.local:3100/otlp"
        }
      },
      "service": {
        "pipelines": {
          "traces": {
            "exporters": [
              "otlp/tempo"
            ]
          },
          "metrics": {
            "exporters": [
              "debug"
            ]
          },
          "logs": {
            "exporters": [
              "otlphttp/loki"
            ]
          }
        }
      }
    },
    "fullnameOverride": "otel-collector-opentelemetry-collector"
  },
  "loki": {
    "fullnameOverride": "loki",
    "deploymentMode": "SingleBinary",
    "loki": {
      "auth_enabled": false,
      "commonConfig": {
        "replication_factor": 1
      },
      "storage": {
        "type": "filesystem"
      },
      "schemaConfig": {
        "configs": [
          {
            "from": "2024-04-01",
            "store": "tsdb",
            "object_store": "filesystem",
            "schema": "v13",
            "index": {
              "prefix": "index_",
              "period": "24h"
            }
          }
        ]
      },
      "limits_config": {
        "retention_period": "24h"
      },
      "compactor": {
        "retention_enabled": true,
        "delete_request_store": "filesystem"
      }
    },
    "singleBinary": {
      "replicas": 1,
      "resources": {
        "requests": {
          "cpu": "100m",
          "memory": "256Mi"
        }
      },
      "persistence": {
        "enabled": true,
        "size": "20Gi",
        "storageClass": "gp3-retain",
        "whenScaled": "Retain",
        "whenDeleted": "Retain",
        "enableStatefulSetAutoDeletePVC": false
      }
    },
    "read": {
      "replicas": 0
    },
    "write": {
      "replicas": 0
    },
    "backend": {
      "replicas": 0
    },
    "minio": {
      "enabled": false
    },
    "chunksCache": {
      "enabled": false
    },
    "resultsCache": {
      "enabled": false
    },
    "gateway": {
      "enabled": false
    },
    "lokiCanary": {
      "enabled": false
    },
    "test": {
      "enabled": false
    }
  },
  "tempo": {
    "fullnameOverride": "tempo",
    "persistence": {
      "enabled": true,
      "storageClassName": "gp3-retain",
      "size": "20Gi"
    },
    "tempo": {
      "retention": "24h",
      "resources": {
        "requests": {
          "cpu": "100m",
          "memory": "256Mi"
        }
      }
    }
  }
}
